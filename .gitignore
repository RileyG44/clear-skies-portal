# Local tile/query cache — rebuilt on demand, ~27 MB and growing
.cache/

# Node
node_modules/
npm-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Script output
*.tif
*.tiff
out/
output/
.playwright-cli/
.codex/
.codex-audits/

# Environment / secrets
.env
.env.local

# Editors & OS
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# Electron build output
dist/
build/icon-1024.png
.ui-stress/

# Markup (annotation) layers live on this machine only
markup/

# Native iOS app (docs/ios CR-001): this Mac's signing team and Xcode user state
ios/Config/Local.xcconfig
ios/**/xcuserdata/
