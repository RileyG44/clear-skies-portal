{
  "name": "Clear Skies Portal",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    "ghcr.io/devcontainers/features/python:1": { "version": "3.14" }
  },

  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "Clear Skies Portal",
      "onAutoForward": "openPreview"
    }
  },

  "containerEnv": {
    "HOST": "0.0.0.0"
  },

  "onCreateCommand": "pip install --no-cache-dir -r requirements.txt",
  "postAttachCommand": "node server.js",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "files.eol": "\n",
        "editor.tabSize": 2
      }
    }
  }
}
