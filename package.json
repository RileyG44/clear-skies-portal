{
  "name": "clear-skies-portal",
  "version": "1.0.0",
  "description": "Finds the most recent satellite imagery for any location on Earth, plus lidar terrain. All sources free, no API key.",
  "private": true,
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "check": "node --check server.js && node --check electron/main.js",
    "app": "electron .",
    "icon": "node build/make-icon.js && rm -rf build/icon.iconset && mkdir -p build/icon.iconset && for s in 16 32 128 256 512; do sips -z $s $s build/icon-1024.png --out build/icon.iconset/icon_${s}x${s}.png >/dev/null; sips -z $((s*2)) $((s*2)) build/icon-1024.png --out build/icon.iconset/icon_${s}x${s}@2x.png >/dev/null; done && iconutil -c icns build/icon.iconset -o build/icon.icns && rm -rf build/icon.iconset",
    "dist": "electron-builder --mac --arm64 && electron-builder --mac --x64"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "satellite",
    "imagery",
    "sentinel-2",
    "landsat",
    "lidar",
    "3dep",
    "leaflet",
    "stac"
  ],
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.rileyg44.clear-skies-portal",
    "productName": "Clear Skies Portal",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "asar": false,
    "files": [
      "electron/**/*",
      "server.js",
      "usgs.js",
      "cog.js",
      "index.html",
      "manifest.json",
      "sw.js",
      "icon-180.png",
      "icon-192.png",
      "icon-512.png",
      "sources.json",
      "LICENSE",
      "*.md",
      "!.cache/**",
      "!dist/**",
      "!build/**",
      "!**/*.py",
      "!requirements.txt"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.reference",
      "icon": "build/icon.icns",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSLocationWhenInUseUsageDescription": "Clear Skies Portal uses your location only to centre the map on where you are.",
        "NSHumanReadableCopyright": "MIT licensed. Imagery from Copernicus, NASA, USGS and WA DNR."
      }
    },
    "dmg": {
      "title": "Clear Skies Portal"
    }
  }
}
