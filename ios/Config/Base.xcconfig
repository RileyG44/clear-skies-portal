// Clear Skies for iPhone (CR-001). Each Mac keeps its signing team in
// Local.xcconfig, copied from Local.example.xcconfig and never committed.
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1
CSP_BUNDLE_ID = dev.riley.ClearSkies
// Drumlin, the fully native app: its own App Store Connect record and
// version line, so its builds never touch ClearSkies.
DRUMLIN_BUNDLE_ID = dev.riley.Drumlin
DRUMLIN_MARKETING_VERSION = 0.1
#include? "Local.xcconfig"
